page {
  background-color: #1A1A1A;
  color: #FFFFFF;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.container {
  min-height: 100vh;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

.card {
  background: #252525;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  color: #B0B0B0;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid #D4AF37;
}

.btn-primary {
  background: linear-gradient(135deg, #D4AF37, #B8962E);
  color: #1A1A1A;
  border-radius: 50rpx;
  height: 96rpx;
  line-height: 60rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.85;
}

/* 主按钮禁用时（分析中）降低饱和度，给用户明确反馈 */
.btn-primary[disabled] {
  background: linear-gradient(135deg, #8A7428, #6E5D20);
  color: #6E6E6E;
  opacity: 0.8;
}

.input-wrap {
  background: #252525;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.input-label {
  font-size: 26rpx;
  color: #B0B0B0;
  margin-bottom: 16rpx;
}

.input-field {
  background: #1A1A1A;
  border: 1rpx solid #3A3A3A;
  border-radius: 12rpx;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: #FFFFFF;
}

.input-field::placeholder {
  color: #8C8C8C;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #3A3A3A;
  border-top-color: #D4AF37;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #B0B0B0;
}

.error-msg {
  text-align: center;
  padding: 60rpx 0;
  color: #FF7A8F;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 说明文字里的加粗片段（原来误用 <b> 标签，WXML 不支持 HTML 标签） */
.hl {
  font-weight: 600;
  color: #E8E8E8;
}

.stat-pill {
  background: #1A1A1A;
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: #B0B0B0;
}

.stat-pill.red { color: #FF7A8F; }
.stat-pill.green { color: #4ADE80; }

.stat-section {
  margin-bottom: 24rpx;
}

.stat-section:last-child {
  margin-bottom: 0;
}

.stat-title {
  font-size: 26rpx;
  color: #B0B0B0;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.stat-note {
  font-size: 22rpx;
  color: #8C8C8C;
  line-height: 1.6;
  margin-bottom: 12rpx;
  padding: 10rpx 14rpx;
  background: rgba(100, 100, 128, 0.12);
  border-radius: 8rpx;
}

/* 统计表横向滚动容器：8 列在 750rpx 屏幕放不下，标签列需要最小宽度 */
.table-scroll {
  width: 100%;
  white-space: nowrap;
}

/* 表格实际所需宽度 = 标签列 220rpx + 固定列 (68+76+96+68+76+88=472rpx)
   + 行内边距 32rpx = 724rpx。标签列是 flex:1，会吸收剩余空间，
   但固定列不能被压缩，所以基准宽度必须 ≥ 固定列 + 标签列最小宽 + 内边距，
   取 820rpx 留出余量，避免文字被压扁换行。 */
.stat-table {
  background: #1A1A1A;
  border-radius: 12rpx;
  overflow: hidden;
  min-width: 820rpx;
}

.stat-table-header {
  display: flex;
  padding: 14rpx 16rpx;
  background: #2A2A2A;
  font-size: 22rpx;
  color: #8C8C8C;
}

.stat-table-row {
  display: flex;
  padding: 14rpx 16rpx;
  border-top: 1rpx solid #333;
  font-size: 24rpx;
  color: #E0E0E0;
}

.col-label {
  flex: 1;
  min-width: 220rpx;
  white-space: normal;
  line-height: 1.4;
}
.col-label.highlight-ratio {
  color: #D4AF37;
}

.col-label.highlight-avg {
  color: #FF8C00;
}

/* 各列宽度：需容纳表头文字（"红成功率"4字 @22rpx 约需 90rpx），
   否则表头文字会被压扁换行、上下行错位。
   flex-shrink:0 是关键 —— 不加的话 flex 布局会重新分配列宽，
   导致表头行和数据行的列宽对不上（实测 23px vs 13px）。 */
.col-count {
  width: 68rpx;
  flex-shrink: 0;
  text-align: center;
}

.col-ratio {
  width: 76rpx;
  flex-shrink: 0;
  text-align: center;
}

.col-rate {
  width: 96rpx;
  flex-shrink: 0;
  text-align: center;
}

.col-avg {
  width: 88rpx;
  flex-shrink: 0;
  text-align: center;
}
/* 综合条件表的标签更长，需要更宽的列 */
.col-label-wide {
  flex: 2;
  min-width: 280rpx;
}

.red { color: #FF7A8F; }
.red-bold { color: #FF7A8F; font-weight: 700; }
.green { color: #4ADE80; }
.bold { font-weight: 700; }

/* 分层旁的信号标记：✅已验证（跨股票检验通过的正/反向信号） ⚠反向（看空信号） */
.sig-tag {
  display: inline-block;
  margin-left: 8rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  vertical-align: middle;
}

.sig-pos {
  background: rgba(15, 157, 88, 0.22);
  color: #4ADE80;
}

.sig-neg {
  background: rgba(233, 69, 96, 0.22);
  color: #FF7A8F;
}

.sig-marg {
  background: rgba(212, 175, 55, 0.2);
  color: #D4AF37;
}

/* 验证统计量：把 ✅已验证 展开成可核对的数据
   （p 值、z 值、10 只股票里几只方向一致），
   让用户能自己判断这是不是噪声，而不是只能选择信或不信。
   放在表格下方独立展示，不挤进 220rpx 宽的标签列。 */
.verify-block {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  background: rgba(100, 100, 128, 0.1);
  border-radius: 8rpx;
}

.verify-title {
  font-size: 20rpx;
  color: #8C8C8C;
  margin-bottom: 10rpx;
}

.verify-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 6rpx 0;
}

.verify-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.verify-left .sig-tag {
  margin-left: 0;
  flex-shrink: 0;
}

.verify-label {
  font-size: 21rpx;
  color: #E0E0E0;
  line-height: 1.4;
  flex: 1;
  min-width: 0;
}

.verify-stats {
  font-size: 20rpx;
  color: #8C8C8C;
  white-space: nowrap;
  flex-shrink: 0;
  text-align: right;
}

.legend-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx 30rpx;
  margin-top: 16rpx;
  padding: 0 8rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #8C8C8C;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.ratio-dot {
  background: #D4AF37;
}

.avg-dot {
  background: #FF8C00;
}

.cond-list {
  background: #1A1A1A;
  border-radius: 12rpx;
  overflow: hidden;
}

.cond-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #333;
}

.cond-item:last-child {
  border-bottom: none;
}

.cond-item.best {
  background: rgba(233, 69, 96, 0.1);
}

.cond-label {
  font-size: 24rpx;
  color: #E0E0E0;
  flex: 1;
}

.cond-metrics {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cond-count {
  font-size: 22rpx;
  color: #8C8C8C;
}

.cond-avg {
  font-size: 26rpx;
  font-weight: 600;
  color: #E0E0E0;
}

.cond-avg.red {
  color: #FF7A8F;
}

.top10-list {
  background: #1A1A1A;
  border-radius: 12rpx;
  overflow: hidden;
  min-width: 980rpx;
}

.top10-header {
  display: flex;
  padding: 14rpx 16rpx;
  background: #2A2A2A;
  font-size: 22rpx;
  color: #8C8C8C;
}

.top10-row {
  display: flex;
  padding: 14rpx 16rpx;
  border-top: 1rpx solid #333;
  font-size: 24rpx;
  color: #E0E0E0;
}

.col-date {
  width: 130rpx;
  flex-shrink: 0;
  color: #B0B0B0;
}

/* 「-3.21%→5.67%」需要约 180rpx，窄了会被截断 */
.col-pct {
  flex: 1;
  min-width: 180rpx;
}

.col-pct.red {
  color: #FF7A8F;
  font-weight: 600;
}

/* 「0.64/-6.20%/-9.40%」需要约 200rpx */
.col-other {
  width: 200rpx;
  flex-shrink: 0;
  text-align: right;
  color: #8C8C8C;
  font-size: 20rpx;
}

.col-other2 {
  width: 140rpx;
  flex-shrink: 0;
  text-align: right;
  color: #B59B4A;
  font-size: 20rpx;
}

/* 下影线 / 竞价量比：对应已验证的看空⑩、看多⑨信号 */
.col-other3 {
  width: 140rpx;
  flex-shrink: 0;
  text-align: right;
  color: #8C8C8C;
  font-size: 20rpx;
}

/* 日内形态 */
.col-other4 {
  width: 170rpx;
  flex-shrink: 0;
  text-align: right;
  color: #6FA0D6;
  font-size: 20rpx;
}

/* Top10 里的日内形态标签 */
.fenshi-tag {
  color: #6FA0D6;
  font-size: 18rpx;
}

.risk-tip {
  font-size: 22rpx;
  color: #8C8C8C;
  line-height: 1.7;
}

/* 首页下拉选择器样式 */
.stat-days-wrap {
  background: #252525;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 24rpx;
}

.days-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #1A1A1A;
  border: 1rpx solid #3A3A3A;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #FFFFFF;
}

.picker-arrow {
  color: #8C8C8C;
  font-size: 20rpx;
}

.stat-conclusion {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: rgba(212, 175, 55, 0.1);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #D4AF37;
  line-height: 1.6;
}

.overall-conclusion {
  margin-top: 20rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.2), rgba(212, 175, 55, 0.05));
  border: 2rpx solid #D4AF37;
  border-radius: 12rpx;
}

.overall-title {
  font-size: 28rpx;
  color: #D4AF37;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.overall-text {
  font-size: 26rpx;
  color: #E0E0E0;
  line-height: 1.6;
}

/* 结果页底部操作区 */
.footer-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.btn-secondary,
.btn-share {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 50rpx;
  margin: 0;
  padding: 0;
}

.btn-secondary {
  background: #252525;
  color: #E0E0E0;
  border: 1rpx solid #3A3A3A;
}

.btn-secondary::after,
.btn-share::after {
  border: none;
}

.btn-share {
  background: linear-gradient(135deg, #D4AF37, #B8962E);
  color: #1A1A1A;
  border: none;
}

.btn-secondary:active,
.btn-share:active {
  opacity: 0.85;
}
