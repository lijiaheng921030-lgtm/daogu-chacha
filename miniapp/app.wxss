page {
  background-color: #1A1A1A;
  color: #FFFFFF;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.container {
  min-height: 100vh;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

.card {
  background: #252525;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  color: #B0B0B0;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid #D4AF37;
}

.btn-primary {
  background: linear-gradient(135deg, #D4AF37, #B8962E);
  color: #1A1A1A;
  border-radius: 50rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.85;
}

.input-wrap {
  background: #252525;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.input-label {
  font-size: 26rpx;
  color: #B0B0B0;
  margin-bottom: 16rpx;
}

.input-field {
  background: #1A1A1A;
  border: 1rpx solid #3A3A3A;
  border-radius: 12rpx;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: #FFFFFF;
}

.input-field::placeholder {
  color: #666666;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #3A3A3A;
  border-top-color: #D4AF37;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #B0B0B0;
}

.error-msg {
  text-align: center;
  padding: 60rpx 0;
  color: #E94560;
  font-size: 28rpx;
}

.verdict-card {
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  text-align: center;
  margin-bottom: 24rpx;
  border: 2rpx solid;
}

.verdict-A {
  background: linear-gradient(135deg, rgba(233,69,96,0.15), rgba(233,69,96,0.05));
  border-color: #E94560;
}

.verdict-B {
  background: linear-gradient(135deg, rgba(15,157,88,0.15), rgba(15,157,88,0.05));
  border-color: #0F9D58;
}

.verdict-C {
  background: rgba(100,100,128,0.15);
  border-color: #666666;
}

.verdict-label {
  font-size: 24rpx;
  color: #B0B0B0;
  margin-bottom: 12rpx;
}

.verdict-text {
  font-size: 48rpx;
  font-weight: 800;
}

.verdict-A .verdict-text { color: #E94560; }
.verdict-B .verdict-text { color: #0F9D58; }
.verdict-C .verdict-text { color: #B0B0B0; }

.verdict-sub {
  font-size: 22rpx;
  color: #666666;
  margin-top: 12rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.stat-item {
  background: #1A1A1A;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}

.stat-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #666666;
}

.stat-pill {
  background: #1A1A1A;
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: #B0B0B0;
}

.stat-pill.red { color: #E94560; }
.stat-pill.green { color: #0F9D58; }

.strategy-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #3A3A3A;
}

.strategy-item:last-child {
  border-bottom: none;
}

.strategy-rank {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rank-1 { background: #D4AF37; color: #1A1A1A; }
.rank-2 { background: #C0C0C0; color: #1A1A1A; }
.rank-3 { background: #CD7F32; color: #FFFFFF; }

.strategy-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.strategy-cond {
  font-size: 26rpx;
  color: #E0E0E0;
}

.strategy-metrics {
  display: flex;
  gap: 20rpx;
}

.metric {
  text-align: center;
}

.metric-val {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #E0E0E0;
}

.metric.highlight .metric-val {
  color: #D4AF37;
}

.metric-label {
  display: block;
  font-size: 20rpx;
  color: #666666;
}

.exec-section {
  margin-bottom: 20rpx;
}

.exec-section:last-child {
  margin-bottom: 0;
}

.exec-title {
  font-size: 26rpx;
  color: #D4AF37;
  margin-bottom: 8rpx;
  font-weight: 600;
}

.exec-text {
  font-size: 25rpx;
  color: #B0B0B0;
  line-height: 1.7;
}

.dow-grid {
  display: flex;
  gap: 12rpx;
}

.dow-item {
  flex: 1;
  background: #1A1A1A;
  border-radius: 12rpx;
  padding: 16rpx 8rpx;
  text-align: center;
}

.dow-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.dow-mean {
  font-size: 20rpx;
  color: #B0B0B0;
}

.dow-max {
  font-size: 20rpx;
  color: #0F9D58;
}

.dim-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  background: rgba(212, 175, 55, 0.2);
  color: #D4AF37;
}

.dim-table {
  width: 100%;
  font-size: 24rpx;
}

.dim-table th {
  background: #1A1A1A;
  color: #666666;
  padding: 14rpx 8rpx;
  text-align: left;
  font-weight: normal;
}

.dim-table td {
  padding: 14rpx 8rpx;
  border-top: 1rpx solid #3A3A3A;
  color: #E0E0E0;
}

.dim-table .val {
  color: #D4AF37;
  font-weight: 600;
}

.tag-zhuichang {
  background: rgba(233, 69, 96, 0.2);
  color: #E94560;
}

.tag-dixi {
  background: rgba(15, 157, 88, 0.2);
  color: #0F9D58;
}

.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
}

.stock-info {
  text-align: center;
  padding: 30rpx 0 20rpx;
}

.stock-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.stock-code {
  font-size: 24rpx;
  color: #666666;
  margin-top: 4rpx;
}
