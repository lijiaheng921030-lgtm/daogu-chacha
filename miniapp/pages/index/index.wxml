<view class="container">
  <!-- 顶部标题 -->
  <view class="header">
    <image class="header-icon" src="/images/rice.png" mode="aspectFit" />
    <view class="header-title">稻谷查查</view>
    <view class="header-sub">个股次日红绿盘统计分析 · 10维度归因</view>
  </view>

  <!-- 股票输入 -->
  <view class="card input-wrap">
    <view class="input-label">输入个股代码或名称</view>
    <input
      class="input-field"
      placeholder="如：000733 或 振华科技"
      value="{{stockInput}}"
      bindinput="onInput"
      bindconfirm="onSearch"
      confirm-type="search"
      disabled="{{loading}}"
    />
    <view class="input-hint">支持6位代码或中文名称模糊匹配</view>
  </view>

  <!-- 样本区间选择 -->
  <view class="card stat-days-wrap">
    <view class="input-label">样本分析区间</view>
    <picker mode="selector" range="{{daysOptions}}" range-key="label" bindchange="onDaysChange" disabled="{{loading}}">
      <view class="days-picker">
        <text>{{selectedDays.label}}</text>
        <text class="picker-arrow">▼</text>
      </view>
    </picker>
    <view class="input-hint">样本越多结论越稳，30日样本仅供参考</view>
  </view>

  <!-- 快速选择 -->
  <view class="card quick-select">
    <view class="section-title">快速选择</view>
    <view class="quick-btns">
      <view class="quick-btn" wx:for="{{quickStocks}}" wx:key="code" bindtap="onQuickSelect" data-code="{{item.code}}">{{item.name}}</view>
    </view>
  </view>

  <!-- 分析按钮 -->
  <button class="btn-primary" bindtap="onSearch" loading="{{loading}}" disabled="{{loading}}" style="text-align: center;">
    {{loading ? '分析中...' : '🌾 开始分析'}}
  </button>

  <!-- 错误提示 -->
  <view class="error-wrap" wx:if="{{errorMsg}}">
    <view class="error-msg">{{errorMsg}}</view>
    <button class="btn-retry" wx:if="{{canRetry}}" bindtap="onRetry">重试</button>
  </view>

  <!-- 功能说明 -->
  <view class="card info-card">
    <view class="section-title">分析维度</view>
    <view class="info-row">
      <view class="info-tag">次日</view>
      <view class="info-text">次日红绿盘归因 · 逐层统计</view>
    </view>
    <view class="info-row">
      <view class="info-tag">10维</view>
      <view class="info-text">量能·均线·竞价·筹码·日内形态</view>
    </view>
    <view class="info-row">
      <view class="info-tag">✅</view>
      <view class="info-text">跨10只股票3335样本验证，未通过的维度不充数</view>
    </view>
  </view>

  <!-- 历史记录入口 -->
  <view class="history-entry" bindtap="goHistory">📜 查看历史记录</view>
</view>
