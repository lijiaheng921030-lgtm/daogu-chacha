<view class="container">
  <!-- 股票信息 -->
  <view class="stock-info">
    <view class="stock-name">{{report.stock_name}}</view>
    <view class="stock-code">{{report.stock_code}}</view>
    <view class="stat-days-tag">近{{report.days}}个交易日 · {{report.total_samples}}样本</view>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{!report}}">
    <view class="loading-spinner"></view>
    <view class="loading-text">正在分析数据...</view>
  </view>

  <block wx:if="{{report}}">
    <!-- 统计分析 -->
    <view class="card">
      <view class="section-title">📊 次日红盘前日统计分析</view>

      <!-- 1. 量比分层 -->
      <view class="stat-section">
        <view class="stat-title">按量比分层</view>
        <view class="stat-table">
          <view class="stat-table-header">
            <text class="col-label">量比区间</text>
            <text class="col-count">次数</text>
            <text class="col-avg">均涨幅</text>
          </view>
          <view class="stat-table-row" wx:for="{{report.vol_stats}}" wx:key="index">
            <text class="col-label {{item.avg > 4 ? 'highlight' : ''}}">{{item.label}}</text>
            <text class="col-count">{{item.count}}</text>
            <text class="col-avg {{item.avg > 4 ? 'red' : ''}}">{{item.avg.toFixed(2)}}%</text>
          </view>
        </view>
      </view>

      <!-- 2. MA5分层 -->
      <view class="stat-section">
        <view class="stat-title">按收盘vs MA5分层</view>
        <view class="stat-table">
          <view class="stat-table-header">
            <text class="col-label">MA5位置</text>
            <text class="col-count">次数</text>
            <text class="col-avg">均涨幅</text>
          </view>
          <view class="stat-table-row" wx:for="{{report.ma5_stats}}" wx:key="index">
            <text class="col-label {{item.avg > 4 ? 'highlight' : ''}}">{{item.label}}</text>
            <text class="col-count">{{item.count}}</text>
            <text class="col-avg {{item.avg > 4 ? 'red' : ''}}">{{item.avg.toFixed(2)}}%</text>
          </view>
        </view>
      </view>

      <!-- 3. MA20分层 -->
      <view class="stat-section">
        <view class="stat-title">按收盘vs MA20分层</view>
        <view class="stat-table">
          <view class="stat-table-header">
            <text class="col-label">MA20位置</text>
            <text class="col-count">次数</text>
            <text class="col-avg">均涨幅</text>
          </view>
          <view class="stat-table-row" wx:for="{{report.ma20_stats}}" wx:key="index">
            <text class="col-label {{item.avg > 4 ? 'highlight' : ''}}">{{item.label}}</text>
            <text class="col-count">{{item.count}}</text>
            <text class="col-avg {{item.avg > 4 ? 'red' : ''}}">{{item.avg.toFixed(2)}}%</text>
          </view>
        </view>
      </view>

      <!-- 4. 前日涨跌幅分布 -->
      <view class="stat-section">
        <view class="stat-title">前日涨跌幅分布（次日红盘前一日）</view>
        <view class="stat-table">
          <view class="stat-table-header">
            <text class="col-label">前日涨跌</text>
            <text class="col-count">次数</text>
            <text class="col-avg">均涨幅</text>
          </view>
          <view class="stat-table-row" wx:for="{{report.dist_stats}}" wx:key="index">
            <text class="col-label {{item.avg > 4 ? 'highlight' : ''}}">{{item.label}}</text>
            <text class="col-count">{{item.count}}</text>
            <text class="col-avg {{item.avg > 4 ? 'red' : ''}}">{{item.avg.toFixed(2)}}%</text>
          </view>
        </view>
      </view>

      <!-- 5. 综合条件 -->
      <view class="stat-section">
        <view class="stat-title">综合条件分析</view>
        <view class="cond-list">
          <view class="cond-item {{item.avg > 5 ? 'best' : ''}}" wx:for="{{report.cond_stats}}" wx:key="index">
            <text class="cond-label">{{item.label}}</text>
            <view class="cond-metrics">
              <text class="cond-count">{{item.count}}次</text>
              <text class="cond-avg {{item.avg > 5 ? 'red' : ''}}">{{item.avg.toFixed(2)}}%</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Top10样本 -->
    <view class="card">
      <view class="section-title">🏆 Top10次日涨幅样本</view>
      <view class="top10-list">
        <view class="top10-header">
          <text class="col-date">日期</text>
          <text class="col-pct">今日→明日</text>
          <text class="col-other">量比/MA5/换手</text>
        </view>
        <view class="top10-row" wx:for="{{report.top10}}" wx:key="index">
          <text class="col-date">{{item.date}}</text>
          <text class="col-pct red">{{item.today_pct}}%→{{item.next_pct}}%</text>
          <text class="col-other">{{item.vol_ratio}}/{{item.vs_ma5}}%/{{item.turnover}}%</text>
        </view>
      </view>
    </view>

    <!-- 风险提示 -->
    <view class="card risk-tip">
      <text>⚠️ 风险提示：以上为历史数据统计分析结果，不构成投资建议。实盘操作自负盈亏，请严格止损。</text>
    </view>
  </block>

  <!-- 返回按钮 -->
  <button class="btn-primary" bindtap="goBack" style="margin-top:30rpx;">🌾 再查一只</button>
</view>
